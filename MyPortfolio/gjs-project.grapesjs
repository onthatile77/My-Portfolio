}]},{"tagName":"span","type":"text","components":[{"tagName":"i","classes":["fa-brands","fa-python"]},{"type":"textnode","content":" Python"}]},{"tagName":"span","type":"text","components":[{"tagName":"i","classes":["fa-brands","fa-docker"]},{"type":"textnode","content":" Docker"}]},{"tagName":"span","type":"text","components":[{"tagName":"i","classes":["fa-brands","fa-git-alt"]},{"type":"textnode","content":" Git"}]}]}]},{"type":"comment","content":" Tech Stack Cards "},{"tagName":"section","classes":["container","section-padding"],"attributes":{"id":"tech"},"components":[{"classes":["section-header"],"components":[{"type":"text","classes":["title-tag"],"components":[{"type":"textnode","content":"What I Build"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Four core pillars of software development I keep coming back to, grounded in actual coursework and self-directed practice."}]}]},{"classes":["services-grid"],"components":[{"type":"comment","content":" Card 1 "},{"classes":["service-card","card-grey"],"components":[{"classes":["icon-box"],"components":[{"tagName":"h3","type":"heading","components":[{"tagName":"span","type":"text","components":[{"type":"textnode","content":"Enterprise Web"}]},{"tagName":"span","type":"text","components":[{"type":"textnode","content":"Applications"}]}]},{"type":"link","classes":["card-link"],"attributes":{"href":"https://github.com/onthatile77","target":"_blank","id":"i9insys"},"components":[{"tagName":"span","classes":["card-link-icon"],"components":[{"tagName":"i","classes":["fa-solid","fa-arrow-right"]}]},{"type":"textnode","content":" Learn more\n            "}]}]},{"tagName":"i","classes":["fa-solid","fa-globe"],"attributes":{"id":"iiglw3g"}}]},{"type":"comment","content":" Card 2 "},{"classes":["service-card","card-green"],"components":[{"classes":["icon-box"],"components":[{"tagName":"h3","type":"heading","components":[{"tagName":"span","type":"text","components":[{"type":"textnode","content":"Desktop"}]},{"tagName":"span","type":"text","components":[{"type":"textnode","content":"Software"}]}]},{"type":"link","classes":["card-link"],"attributes":{"href":"https://github.com/onthatile77","target":"_blank","id":"izcrqb4"},"components":[{"tagName":"span","classes":["card-link-icon"],"components":[{"tagName":"i","classes":["fa-solid","fa-arrow-right"]}]},{"type":"textnode","content":" Learn more\n            "}]}]},{"tagName":"i","classes":["fa-solid","fa-window-restore"],"attributes":{"id":"iiryi8s"}}]},{"type":"comment","content":" Card 3 "},{"classes":["service-card","card-dark"],"components":[{"classes":["icon-box"],"components":[{"tagName":"h3","type":"heading","components":[{"tagName":"span","type":"text","components":[{"type":"textnode","content":"Blazor Server"}]},{"tagName":"span","type":"text","components":[{"type":"textnode","content":"Apps"}]}]},{"type":"link","classes":["card-link"],"attributes":{"href":"https://github.com/onthatile77","target":"_blank","id":"i3xrf02"},"components":[{"tagName":"span","classes":["card-link-icon"],"components":[{"tagName":"i","classes":["fa-solid","fa-arrow-right"]}]},{"type":"textnode","content":" Learn more\n            "}]}]},{"tagName":"i","classes":["fa-solid","fa-layer-group"],"attributes":{"id":"iitn7oj"}}]},{"type":"comment","content":" Card 4 "},{"classes":["service-card","card-grey"],"components":[{"classes":["icon-box"],"components":[{"tagName":"h3","type":"heading","components":[{"tagName":"span","type":"text","components":[{"type":"textnode","content":"Database-driven"}]},{"tagName":"span","type":"text","components":[{"type":"textnode","content":"Systems"}]}]},{"type":"link","classes":["card-link"],"attributes":{"href":"https://github.com/onthatile77","target":"_blank","id":"il6nneo"},"components":[{"tagName":"span","classes":["card-link-icon"],"components":[{"tagName":"i","classes":["fa-solid","fa-arrow-right"]}]},{"type":"textnode","content":" Learn more\n            "}]}]},{"tagName":"i","classes":["fa-solid","fa-database"],"attributes":{"id":"i3f73dm"}}]}]}]},{"type":"comment","content":" CTA Section "},{"tagName":"section","classes":["container"],"attributes":{"id":"iojm6e1"},"components":[{"classes":["cta-box"],"components":[{"classes":["cta-content"],"components":[{"tagName":"h2","type":"heading","components":[{"type":"textnode","content":"Let’s make things happen"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Open to graduate roles, internships, and freelance software development work. Get in touch to learn how my skills in C# and Java can fit into your team."}]},{"type":"link","classes":["btn","btn-dark"],"attributes":{"href":"#contact"},"components":[{"type":"textnode","content":"Get your free proposal"}]}]},{"classes":["cta-graphics"]}]}]},{"type":"comment","content":" Case Studies / Featured Principles "},{"tagName":"section","classes":["container"],"attributes":{"id":"i1a7msn"},"components":[{"classes":["section-header"],"components":[{"type":"text","classes":["title-tag"],"components":[{"type":"textnode","content":"Principles"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Real-life examples of how I approach problem-solving and writing reliable code."}]}]},{"classes":["projects-box"],"components":[{"classes":["project-item"],"components":[{"tagName":"p","type":"text","components":[{"type":"textnode","content":"For backend logic, I prioritize clean architecture and separation of concerns, ensuring data models in SQL translate perfectly to C# entities without messy logic."}]},{"type":"link","classes":["project-link"],"attributes":{"href":"https://github.com/onthatile77"},"components":[{"type":"textnode","content":"View code "},{"tagName":"i","classes":["fa-solid","fa-arrow-right"]}]}]},{"classes":["project-divider"]},{"classes":["project-item"],"components":[{"tagName":"p","type":"text","components":[{"type":"textnode","content":"When building user interfaces (like Blazor or WinForms), I design for the user's actual workflow—creating state management that holds up under edge cases."}]},{"type":"link","classes":["project-link"],"attributes":{"href":"https://github.com/onthatile77"},"components":[{"type":"textnode","content":"View code "},{"tagName":"i","classes":["fa-solid","fa-arrow-right"]}]}]},{"classes":["project-divider"]},{"classes":["project-item"],"components":[{"tagName":"p","type":"text","components":[{"type":"textnode","content":"I constantly hone my data structure and algorithmic skills on HackerRank, keeping my core computer science fundamentals sharp for complex problems."}]},{"type":"link","classes":["project-link"],"attributes":{"href":"https://www.hackerrank.com/onthatile_0318","target":"_blank"},"components":[{"type":"textnode","content":"View profile "},{"tagName":"i","classes":["fa-solid","fa-arrow-right"]}]}]}]}]},{"type":"comment","content":" Working Process "},{"tagName":"section","classes":["container","section-padding"],"attributes":{"id":"process"},"components":[{"classes":["section-header"],"components":[{"type":"text","classes":["title-tag"],"components":[{"type":"textnode","content":"Our Working Process"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Step-by-Step Guide to how I take software from an initial concept to a production-ready application."}]}]},{"classes":["process-list"],"components":[{"type":"comment","content":" Accordion Item 1 (Open by default in JS) "},{"classes":["process-item","active"],"components":[{"classes":["process-header"],"components":[{"type":"text","classes":["process-title"],"components":[{"tagName":"span","type":"text","classes":["num"],"components":[{"type":"textnode","content":"01"}]},{"type":"textnode","content":" Understand the problem"}]},{"classes":["process-icon"],"attributes":{"id":"i2xa2fh"},"components":[{"tagName":"i","classes":["fa-solid","fa-minus"],"attributes":{"id":"i7h7hx9"}}]}]},{"type":"text","classes":["process-body"],"components":[{"type":"textnode","content":"\n            Before writing a single line of code, I make sure I understand what the software actually needs to do. Discussing goals, target audience, and current pain points allows me to tailor the backend architecture perfectly.\n          "}]}]},{"type":"comment","content":" Accordion Item 2 "},{"classes":["process-item"],"attributes":{"id":"i90s77f"},"components":[{"classes":["process-header"],"components":[{"type":"text","classes":["process-title"],"components":[{"tagName":"span","type":"text","classes":["num"],"components":[{"type":"textnode","content":"02"}]},{"type":"textnode","content":" Design the structure"}]},{"classes":["process-icon"],"attributes":{"id":"ix3owyd"},"components":[{"tagName":"i","classes":["fa-solid","fa-plus"],"attributes":{"id":"iu7lau9"}}]}]},{"type":"text","classes":["process-body"],"components":[{"type":"textnode","content":"\n            Data models, schemas, and UI layouts get made deliberately, often mapped out on paper or design tools, before implementation starts. This saves hours of refactoring later.\n          "}]}]},{"type":"comment","content":" Accordion Item 3 "},{"classes":["process-item"],"components":[{"classes":["process-header"],"components":[{"type":"text","classes":["process-title"],"components":[{"tagName":"span","type":"text","classes":["num"],"components":[{"type":"textnode","content":"03"}]},{"type":"textnode","content":" Build in increments"}]},{"classes":["process-icon"],"components":[{"tagName":"i","classes":["fa-solid","fa-plus"]}]}]},{"type":"text","classes":["process-body"],"components":[{"type":"textnode","content":"\n            I develop in small, testable pieces using C#, Java, or SQL. Everything is version-controlled with Git from the very first commit to ensure safe rollbacks and clean collaboration.\n          "}]}]},{"type":"comment","content":" Accordion Item 4 "},{"classes":["process-item"],"components":[{"classes":["process-header"],"components":[{"type":"text","classes":["process-title"],"components":[{"tagName":"span","type":"text","classes":["num"],"components":[{"type":"textnode","content":"04"}]},{"type":"textnode","content":" Test against reality"}]},{"classes":["process-icon"],"components":[{"tagName":"i","classes":["fa-solid","fa-plus"]}]}]},{"type":"text","classes":["process-body"],"components":[{"type":"textnode","content":"\n            Testing against edge cases, bad inputs, and real-world data volumes. I don't just test the \"happy path\"; I ensure the software behaves correctly when things go wrong.\n          "}]}]},{"type":"comment","content":" Accordion Item 5 "},{"classes":["process-item"],"components":[{"classes":["process-header"],"components":[{"type":"text","classes":["process-title"],"components":[{"tagName":"span","type":"text","classes":["num"],"components":[{"type":"textnode","content":"05"}]},{"type":"textnode","content":" Document and hand off"}]},{"classes":["process-icon"],"components":[{"tagName":"i","classes":["fa-solid","fa-plus"]}]}]},{"type":"text","classes":["process-body"],"components":[{"type":"textnode","content":"\n            Writing clear, concise documentation so that someone else—or future me—can pick up the codebase without needing a walkthrough.\n          "}]}]}]}]},{"type":"comment","content":" About Me (Adapted from Team section) "},{"tagName":"section","classes":["container","section-padding"],"attributes":{"id":"about"},"components":[{"classes":["section-header"],"components":[{"type":"text","classes":["title-tag"],"components":[{"type":"textnode","content":"About Me"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Meet the developer behind the code. A mix of academic rigor and self-taught practical skills."}]}]},{"classes":["about-grid"],"components":[{"classes":["about-card"],"components":[{"classes":["about-top"],"components":[{"classes":["about-icon"],"components":[{"tagName":"i","classes":["fa-solid","fa-graduation-cap"]}]},{"classes":["about-info"],"components":[{"tagName":"h4","type":"heading","components":[{"type":"textnode","content":"BSc IT Student"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"North-West University"}]}]}]},{"classes":["about-divider"]},{"tagName":"p","type":"text","classes":["desc"],"components":[{"type":"textnode","content":"Currently in my final year, mastering core computer science concepts, database management, and enterprise software architecture."}]}]},{"classes":["about-card"],"attributes":{"id":"ivs80mv"},"components":[{"classes":["about-top"],"components":[{"classes":["about-icon"],"components":[{"tagName":"i","classes":["fa-solid","fa-server"]}]},{"classes":["about-info"],"components":[{"tagName":"h4","type":"heading","components":[{"type":"textnode","content":"Backend Specialist"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":".NET & Java ecosystem"}]}]}]},{"classes":["about-divider"]},{"tagName":"p","type":"text","classes":["desc"],"components":[{"type":"textnode","content":"Passionate about building scalable logic. Experience in C#, Java, ASP.NET, and integrating real-world SQL databases securely."}]}]},{"classes":["about-card"],"attributes":{"id":"iihtqe3"},"components":[{"classes":["about-top"],"components":[{"classes":["about-icon"],"components":[{"tagName":"i","classes":["fa-solid","fa-puzzle-piece"]}]},{"classes":["about-info"],"components":[{"tagName":"h4","type":"heading","components":[{"type":"textnode","content":"Problem Solver"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"HackerRank Enthusiast"}]}]}]},{"classes":["about-divider"]},{"tagName":"p","type":"text","classes":["desc"],"components":[{"type":"textnode","content":"Strong logical foundation. I enjoy tackling complex algorithms and optimizing code for performance, memory, and readability."}]}]}]}]},{"type":"comment","content":" Contact Form "},{"tagName":"section","classes":["container","section-padding"],"attributes":{"id":"contact"},"components":[{"classes":["section-header"],"components":[{"type":"text","classes":["title-tag"],"attributes":{"id":"i0f4xng"},"components":[{"type":"textnode","content":"Contact Me"}]},{"tagName":"p","type":"text","attributes":{"id":"i2v8tc2"},"components":[{"type":"textnode","content":"Connect with me: Let's discuss your software needs, internships, or grad roles."}]}]},{"classes":["contact-wrapper"],"components":[{"type":"form","classes":["contact-form"],"attributes":{"method":"POST","action":"#"},"components":[{"type":"comment","content":" Form Header "},{"attributes":{"id":"ieo4svl"},"components":[{"type":"label","attributes":{"id":"ifadrmj"},"components":[{"type":"radio","void":true,"attributes":{"type":"radio","name":"contact-type","checked":true,"id":"ixrfk9s"}},{"type":"textnode","content":" Say Hi\n            "}]}]},{"classes":["form-group"],"components":[{"type":"label","components":[{"type":"textnode","content":"Name"}]},{"type":"input","void":true,"attributes":{"type":"text","placeholder":"Name"}}]},{"classes":["form-group"],"components":[{"type":"label","components":[{"type":"textnode","content":"Email*"}]},{"type":"input","void":true,"attributes":{"type":"email","placeholder":"Email","required":true}}]},{"classes":["form-group"],"components":[{"type":"label","components":[{"type":"textnode","content":"Message*"}]},{"type":"textarea","attributes":{"placeholder":"Message","required":true}}]},{"type":"button","classes":["btn","btn-dark"],"attributes":{"type":"submit","id":"i6yw3se"},"components":[{"type":"contentEditable","components":[{"type":"textnode","content":"Send Message"}]}]}]},{"type":"comment","content":" Background visual graphic "},{"classes":["contact-visual"],"components":[{"tagName":"i","classes":["fa-regular","fa-comment-dots"]}]}]}]}]},{"type":"comment","content":" Footer "},{"tagName":"footer","components":[{"classes":["container"],"components":[{"classes":["footer-top"],"components":[{"type":"link","classes":["footer-logo"],"attributes":{"href":"#"},"components":[{"tagName":"i","classes":["fa-solid","fa-code"],"attributes":{"id":"ip56nf9"}},{"type":"textnode","content":" LM.\n        "}]},{"classes":["footer-links"],"components":[{"type":"link","attributes":{"href":"#about"},"components":[{"type":"textnode","content":"About"}]},{"type":"link","attributes":{"href":"#tech"},"components":[{"type":"textnode","content":"Tech Stack"}]},{"type":"link","attributes":{"href":"#process"},"components":[{"type":"textnode","content":"Process"}]},{"type":"link","attributes":{"href":"#contact"},"components":[{"type":"textnode","content":"Contact"}]}]},{"classes":["footer-socials"],"components":[{"type":"link","attributes":{"href":"https://github.com/onthatile77","target":"_blank"},"components":[{"tagName":"i","classes":["fa-brands","fa-github"]}]},{"type":"link","attributes":{"href":"https://www.hackerrank.com/onthatile_0318","target":"_blank"},"components":[{"tagName":"i","classes":["fa-brands","fa-hackerrank"]}]},{"type":"link","attributes":{"href":"https://wa.me/27665684082","target":"_blank"},"components":[{"tagName":"i","classes":["fa-brands","fa-whatsapp"]}]}]}]},{"classes":["footer-mid"],"components":[{"classes":["footer-contact"],"components":[{"type":"text","classes":["tag"],"components":[{"type":"textnode","content":"Contact me:"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Email: onthatile.0318@gmail.com"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Location: Vereeniging, South Africa"}]}]},{"type":"comment","content":" CTA inside footer instead of newsletter "},{"attributes":{"id":"i5jxbd9"},"components":[{"type":"link","classes":["btn","btn-green"],"attributes":{"href":"./assets/CV_Leatile.pdf","download":"Leatile_Moila_CV.pdf","id":"inyxxd5"},"components":[{"tagName":"i","classes":["fa-solid","fa-file-arrow-down"]},{"type":"textnode","content":" Download Resume\n          "}]}]}]},{"classes":["footer-bottom"],"components":[{"tagName":"p","type":"text","components":[{"type":"textnode","content":"© 2026 Leatile Moila. All Rights Reserved."}]},{"tagName":"p","type":"text","attributes":{"id":"i5jcr1c"},"components":[{"type":"textnode","content":"Privacy Policy"}]}]}]}]},{"type":"comment","content":" JavaScript for the Working Process Accordion "},{"type":"script","components":[{"type":"textnode","content":"\n    document.addEventListener(\"DOMContentLoaded\", () => {\n      const processItems = document.querySelectorAll('.process-item');\n\n      processItems.forEach(item => {\n        const header = item.querySelector('.process-header');\n        \n        header.addEventListener('click', () => {\n          const isActive = item.classList.contains('active');\n          \n          // Close all\n          processItems.forEach(el => {\n            el.classList.remove('active');\n            el.querySelector('.process-icon i').className = 'fa-solid fa-plus';\n          });\n\n          // Open clicked if it wasn't already open\n          if (!isActive) {\n            item.classList.add('active');\n            item.querySelector('.process-icon i').className = 'fa-solid fa-minus';\n          }\n        });\n      });\n    });\n  "}]}],"doctype":"<!DOCTYPE html>","head":{"type":"head","components":[{"tagName":"meta","void":true,"attributes":{"charset":"UTF-8"}},{"tagName":"meta","void":true,"attributes":{"name":"viewport","content":"width=device-width, initial-scale=1.0"}},{"tagName":"title","type":"text","components":[{"type":"textnode","content":"Leatile Moila | Software Developer"}]},{"type":"comment","content":" Using Space Grotesk, the exact font from the design you provided "},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.googleapis.com"}},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.gstatic.com","crossorigin":""}},{"tagName":"link","void":true,"attributes":{"href":"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap","rel":"stylesheet"}},{"tagName":"link","void":true,"attributes":{"rel":"stylesheet","href":"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"}}]},"docEl":{"tagName":"html","attributes":{"lang":"en"}}},"id":"uvW4leoBnySqsuBp","minHeight":"500px"}],"id":"VcjrtZYUd5llKH2Y"}],"symbols":[{"type":"flex-column","classes":["gjs-plg-flex-column"],"attributes":{"data-type-role":"flex-column","id":"ivc2y-2"},"__symbols":[],"components":[{"type":"link","classes":["gjs-t-button","button"],"attributes":{"href":"https://app.grapesjs.com/docs-sdk/overview/getting-started","target":"_blank","id":"ig2ff"},"__symbols":[],"components":[{"type":"textnode","content":"\n                Studio SDK Docs\n              ","attributes":{"id":"ijeb3"},"__symbols":[]}]}]}],"custom":{"projectType":"web","id":""}}